generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CampaignLists {
  A             String
  B             String
  campaigns     campaigns     @relation(fields: [A], references: [id], onDelete: Cascade)
  mailing_lists mailing_lists @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_CampaignLists_AB_pkey")
  @@index([B], map: "_CampaignLists_B_index")
  @@map("_CampaignLists")
}

model CampaignSegments {
  A         String
  B         String
  campaigns campaigns @relation(fields: [A], references: [id], onDelete: Cascade)
  segments  segments  @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_CampaignSegments_AB_pkey")
  @@index([B], map: "_CampaignSegments_B_index")
  @@map("_CampaignSegments")
}

model accounts {
  id        String   @id
  apiKeyId  String
  name      String
  domain    String?
  industry  String?
  employees Int?
  revenue   String?
  website   String?
  linkedin  String?
  city      String?
  country   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  api_keys  api_keys @relation(fields: [apiKeyId], references: [id])
  leads     leads[]

  @@unique([apiKeyId, domain])
  @@index([apiKeyId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model api_keys {
  id                         String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  keyHash                    String             @unique
  keyPrefix                  String
  label                      String?
  ownerId                    String?
  rateLimit                  Int                @default(1000)
  isActive                   Boolean            @default(true)
  createdAt                  DateTime           @default(now())
  revokedAt                  DateTime?
  userId                     String?
  keyRaw                     String?
  monthlyLimit               Int                @default(1000)
  currentMonthUsage          Int                @default(0)
  usageResetAt               DateTime?          @default(dbgenerated("date_trunc('month'::text, (now() + '1 mon'::interval))")) @db.Timestamp(6)
  plan                       String             @default("free")
  monthlySendLimit           Int                @default(500)
  currentMonthSendUsage      Int                @default(0)
  sendUsageResetAt           DateTime           @default(dbgenerated("date_trunc('month'::text, (now() + '1 mon'::interval))"))
  name                       String?
  permission                 String             @default("full_access")
  restrictedDomainId         String?
  lastUsedAt                 DateTime?
  org_id                     String?
  extra_verification_credits Int                @default(0)
  extra_send_credits         Int                @default(0)
  allowed_ips                String[]           @default([])
  usage_alert_enabled        Boolean            @default(true)
  usage_alert_sent_at        DateTime?          @db.Timestamptz(6)
  expires_at                 DateTime?          @db.Timestamptz(6)
  accounts                   accounts[]
  api_request_logs           api_request_logs[]
  automations                automations[]
  bulk_jobs                  bulk_jobs[]
  campaigns                  campaigns[]
  contacts                   contacts[]
  email_templates            email_templates[]
  inbox_tests                inbox_tests[]
  leads                      leads[]
  mailboxes                  mailboxes[]
  mailing_lists              mailing_lists[]
  monitors                   monitors[]
  segments                   segments[]
  send_messages              send_messages[]
  sending_domains            sending_domains[]
  sequences                  sequences[]
  team_invites               team_invites[]
  team_members               team_members[]
  verifications              verifications[]
  webhooks                   webhooks[]
  brand_kits                 brand_kits?
  connector_secrets          connector_secrets[]
  connector_rules            connector_rules[]
  connector_events           connector_events[]

  @@index([org_id])
  @@index([userId])
}

model brand_kits {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  api_key_id    String   @unique
  logo_url      String?
  primary_color String   @default("#000000")
  font_family   String   @default("Arial, sans-serif")
  company_name  String?
  from_name     String?
  footer_text   String?
  website_url   String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  api_keys      api_keys @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

model connector_secrets {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  api_key_id   String
  connector    String
  secret       String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  api_keys     api_keys @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@unique([api_key_id, connector])
  @@map("connector_secrets")
}

model connector_rules {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  api_key_id  String
  connector   String
  event_type  String
  action      String   @default("send_template")
  template_id String?
  sequence_id String?
  enabled     Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  api_keys    api_keys @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@unique([api_key_id, connector, event_type])
  @@index([api_key_id])
  @@map("connector_rules")
}

model connector_events {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  api_key_id   String
  connector    String
  event_type   String
  normalized   Json
  status       String   @default("received")
  error_msg    String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  api_keys     api_keys @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@index([api_key_id, created_at(sort: Desc)])
  @@index([api_key_id, connector])
  @@map("connector_events")
}

model api_request_logs {
  id          String   @id
  api_key_id  String
  method      String
  path        String
  status_code Int
  duration_ms Int
  source_ip   String?
  request_id  String?
  error_code  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  api_keys    api_keys @relation(fields: [api_key_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([api_key_id, created_at(sort: Desc)], map: "api_request_logs_api_key_created")
  @@index([created_at(sort: Desc)], map: "api_request_logs_created")
}

model audit_logs {
  id          String   @id
  org_id      String?
  api_key_id  String?
  action      String
  actor_id    String
  actor_email String
  actor_ip    String?
  targets     Json
  created_at  DateTime @default(now())

  @@index([api_key_id])
  @@index([created_at])
  @@index([org_id])
}

model automation_enrollments {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  automation_id String
  email         String
  data          Json?
  status        String      @default("active")
  current_step  Int         @default(0)
  next_send_at  DateTime?   @db.Timestamptz(6)
  enrolled_at   DateTime    @default(now()) @db.Timestamptz(6)
  completed_at  DateTime?   @db.Timestamptz(6)
  automations   automations @relation(fields: [automation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([automation_id, email])
}

model automation_steps {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  automation_id String
  step_order    Int
  delay_hours   Int         @default(0)
  subject       String
  html_body     String
  text_body     String?
  from_name     String?
  from_email    String?
  domain_id     String?
  automations   automations @relation(fields: [automation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([automation_id, step_order])
}

model automations {
  id                     String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  api_key_id             String
  name                   String
  trigger_event          String
  status                 String                   @default("active")
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  automation_enrollments automation_enrollments[]
  automation_steps       automation_steps[]
  api_keys               api_keys                 @relation(fields: [api_key_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([api_key_id], map: "idx_automations_api_key_id")
  @@index([api_key_id, trigger_event], map: "idx_automations_api_key_trigger")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bulk_job_emails {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  bulkJobId      String
  email          String
  rowIndex       Int
  isDuplicate    Boolean   @default(false)
  status         String?
  subStatus      String?
  score          Int?
  domain         String?
  isDisposable   Boolean?
  isRoleAccount  Boolean?
  mxFound        Boolean?
  smtpChecked    Boolean?
  smtpReachable  Boolean?
  isCatchAll     Boolean?
  greylisted     Boolean   @default(false)
  durationMs     Int?
  verificationId String?
  errorMessage   String?
  processedAt    DateTime?
  syntaxValid    Boolean?
  spfValid       Boolean?
  dkimFound      Boolean?
  dmarcValid     Boolean?
  blacklisted    Boolean?
  bulk_jobs      bulk_jobs @relation(fields: [bulkJobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bulkJobId])
  @@index([bulkJobId, rowIndex], map: "bulk_job_emails_rowIndex_idx")
  @@index([bulkJobId, status], map: "bulk_job_emails_status_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bulk_jobs {
  id              String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  apiKeyId        String
  fileName        String
  storagePath     String
  totalEmails     Int
  processedCount  Int               @default(0)
  validCount      Int               @default(0)
  invalidCount    Int               @default(0)
  riskyCount      Int               @default(0)
  unknownCount    Int               @default(0)
  duplicateCount  Int               @default(0)
  errorCount      Int               @default(0)
  status          BulkJobStatus     @default(pending)
  errorMessage    String?
  exportPath      String?
  createdAt       DateTime          @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  webhookSent     Boolean           @default(false)
  bulk_job_emails bulk_job_emails[]
  api_keys        api_keys          @relation(fields: [apiKeyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifications   verifications[]

  @@index([apiKeyId])
  @@index([createdAt])
  @@index([status])
}

model campaign_recipients {
  id           String    @id
  campaignId   String
  contactId    String?
  email        String
  status       String    @default("pending")
  sesMessageId String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  variant      String    @default("a")
  campaigns    campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([sesMessageId])
}

model campaigns {
  id                  String                @id
  apiKeyId            String
  fromName            String
  fromEmail           String
  domainId            String?
  replyTo             String?
  subject             String
  htmlBody            String
  textBody            String?
  status              String                @default("draft")
  trackOpens          Boolean               @default(true)
  trackClicks         Boolean               @default(true)
  scheduledAt         DateTime?
  sentAt              DateTime?
  totalRecipients     Int                   @default(0)
  sentCount           Int                   @default(0)
  deliveredCount      Int                   @default(0)
  openCount           Int                   @default(0)
  clickCount          Int                   @default(0)
  bounceCount         Int                   @default(0)
  complaintCount      Int                   @default(0)
  sendDays            String[]              @default(["monday", "tuesday", "wednesday", "thursday", "friday"])
  sendStartHour       Int                   @default(8)
  sendEndHour         Int                   @default(17)
  timezone            String                @default("UTC")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  name                String                @default("")
  listIds             String[]              @default([])
  segmentIds          String[]              @default([])
  excludeListIds      String[]              @default([])
  preheader           String?
  send_days           String[]              @default(["monday", "tuesday", "wednesday", "thursday", "friday"])
  send_start_hour     Int                   @default(8)
  send_end_hour       Int                   @default(17)
  subject_b           String?
  open_count_b        Int                   @default(0)
  click_count_b       Int                   @default(0)
  excluded_emails     String[]              @default([])
  retarget_of_id      String?
  send_rate_per_hour  Int?
  CampaignLists       CampaignLists[]
  CampaignSegments    CampaignSegments[]
  campaign_recipients campaign_recipients[]
  api_keys            api_keys              @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId, status])
}

model contact_list_memberships {
  id             String        @id
  contactId      String
  listId         String
  status         String        @default("subscribed")
  gdprConsent    Boolean       @default(false)
  subscribedAt   DateTime      @default(now())
  unsubscribedAt DateTime?
  contacts       contacts      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  mailing_lists  mailing_lists @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
  @@index([listId, status])
}

model contacts {
  id                       String                     @id
  apiKeyId                 String
  email                    String
  firstName                String?
  lastName                 String?
  customFields             Json?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now())
  contact_list_memberships contact_list_memberships[]
  api_keys                 api_keys                   @relation(fields: [apiKeyId], references: [id])

  @@unique([apiKeyId, email])
  @@index([apiKeyId])
}

model email_template_versions {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  templateId      String
  version         Int
  name            String
  subject         String
  htmlBody        String
  textBody        String?
  variables       Json?
  savedAt         DateTime        @default(now()) @db.Timestamptz(6)
  savedBy         String?
  email_templates email_templates @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([templateId, version(sort: Desc)], map: "idx_template_versions_template")
}

model email_templates {
  id                      String                    @id
  apiKeyId                String
  name                    String
  subject                 String
  htmlBody                String
  textBody                String?
  variables               Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  preheader               String?
  email_template_versions email_template_versions[]
  api_keys                api_keys                  @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId])
}

model inbox_tests {
  id        String    @id
  apiKeyId  String
  subject   String
  fromEmail String
  domainId  String?
  status    String    @default("pending")
  results   Json?
  score     Int?
  createdAt DateTime  @default(now())
  checkedAt DateTime?
  api_keys  api_keys  @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId])
}

model leads {
  id             String    @id
  apiKeyId       String
  email          String
  firstName      String?
  lastName       String?
  company        String?
  title          String?
  customVars     Json?
  status         String    @default("active")
  repliedAt      DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
  tags           String[]  @default([])
  accountId      String?
  accounts       accounts? @relation(fields: [accountId], references: [id])
  api_keys       api_keys  @relation(fields: [apiKeyId], references: [id])

  @@unique([apiKeyId, email])
  @@index([accountId])
  @@index([apiKeyId, status])
}

model mailboxes {
  id               String          @id
  apiKeyId         String
  type             String
  label            String?
  host             String?
  port             Int?
  username         String
  passwordEnc      String?
  oauthTokenEnc    String?
  dailyLimit       Int             @default(200)
  sendDelayMinMs   Int             @default(30000)
  sendDelayMaxMs   Int             @default(120000)
  sentToday        Int             @default(0)
  sentTodayResetAt DateTime        @default(now())
  status           String          @default("active")
  lastErrorMsg     String?
  lastCheckedAt    DateTime?
  createdAt        DateTime        @default(now())
  api_keys         api_keys        @relation(fields: [apiKeyId], references: [id])
  reply_events     reply_events[]
  warmup_configs   warmup_configs?

  @@index([apiKeyId, status])
}

model mailing_lists {
  id                       String                     @id
  apiKeyId                 String
  name                     String
  description              String?
  contactCount             Int                        @default(0)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now())
  CampaignLists            CampaignLists[]
  contact_list_memberships contact_list_memberships[]
  api_keys                 api_keys                   @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model monitor_checks {
  id             String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  monitorId      String
  verificationId String
  statusChanged  Boolean
  previousStatus VerificationStatus?
  newStatus      VerificationStatus
  source         String              @default("scheduled")
  checkedAt      DateTime            @default(now())
  durationMs     Int?
  webhookSent    Boolean             @default(false)
  monitors       monitors            @relation(fields: [monitorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([checkedAt])
  @@index([monitorId, checkedAt])
  @@index([monitorId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model monitors {
  id                  String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  apiKeyId            String
  email               String
  intervalHours       Int                 @default(24)
  isActive            Boolean             @default(true)
  lastCheckedAt       DateTime?
  nextCheckAt         DateTime
  lastStatus          VerificationStatus?
  consecutiveFailures Int                 @default(0)
  pausedAt            DateTime?
  failureReason       String?
  tags                String[]            @default([])
  notifyOnAnyChange   Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now())
  isPaused            Boolean             @default(false)
  monitor_checks      monitor_checks[]
  api_keys            api_keys            @relation(fields: [apiKeyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([apiKeyId, email])
  @@index([isActive, nextCheckAt])
  @@index([nextCheckAt])
}

model org_members {
  id            String   @id
  user_id       String
  org_id        String
  membership_id String   @unique
  role          String   @default("member")
  email         String
  status        String   @default("active")
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
  users         users    @relation(fields: [user_id], references: [id])

  @@unique([user_id, org_id])
  @@index([org_id])
}

model org_settings {
  id           String   @id
  org_id       String   @unique
  name         String?
  domain       String?
  mfa_required Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())
}

model processed_webhooks {
  id        String   @id
  source    String
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id        String   @id
  userId    String   @unique
  email     String
  fullName  String?
  plan      String   @default("free")
  createdAt DateTime @default(now())
}

model reply_events {
  id                   String                @id
  mailboxId            String
  fromEmail            String
  inReplyToMessageId   String?
  enrollmentId         String?
  campaignRecipientId  String?
  subject              String?
  bodySnippet          String?
  isRead               Boolean               @default(false)
  status               String                @default("new")
  receivedAt           DateTime              @default(now())
  sequence_enrollments sequence_enrollments? @relation(fields: [enrollmentId], references: [id])
  mailboxes            mailboxes             @relation(fields: [mailboxId], references: [id])

  @@index([enrollmentId])
  @@index([mailboxId])
}

model segments {
  id               String             @id
  apiKeyId         String
  listId           String?
  name             String
  filterRules      Json
  createdAt        DateTime           @default(now())
  CampaignSegments CampaignSegments[]
  api_keys         api_keys           @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId])
}

model send_events {
  id            String        @id
  sendMessageId String
  type          SendEventType
  rawPayload    Json
  occurredAt    DateTime      @default(now())
  send_messages send_messages @relation(fields: [sendMessageId], references: [id], onDelete: Cascade)

  @@index([sendMessageId])
}

model send_messages {
  id               String            @id
  apiKeyId         String
  to               String
  from             String
  replyTo          String?
  subject          String
  sesMessageId     String?           @unique
  status           SendStatus        @default(queued)
  errorMessage     String?
  verificationId   String?
  createdAt        DateTime          @default(now())
  sentAt           DateTime?
  cc               String[]          @default([])
  bcc              String[]          @default([])
  scheduledAt      DateTime?
  templateId       String?
  tags             Json?
  trackingToken    String?           @unique
  domainId         String?
  idempotencyKey   String?           @unique
  sequence_step_id String?
  send_events      send_events[]
  api_keys         api_keys          @relation(fields: [apiKeyId], references: [id])
  verifications    verifications?    @relation(fields: [verificationId], references: [id])
  tracking_events  tracking_events[]

  @@index([apiKeyId, createdAt])
  @@index([apiKeyId])
  @@index([sequence_step_id])
  @@index([sesMessageId])
}

model sending_domains {
  id                String    @id
  apiKeyId          String
  name              String
  status            String    @default("pending")
  region            String    @default("us-east-1")
  dkimSelector      String
  dkimPublicKey     String
  dkimPrivateKeyEnc String
  spfStatus         String    @default("pending")
  dkimStatus        String    @default("pending")
  returnPathStatus  String    @default("pending")
  trackOpens        Boolean   @default(true)
  trackClicks       Boolean   @default(true)
  createdAt         DateTime  @default(now())
  verifiedAt        DateTime?
  trackingDomain    String?
  api_keys          api_keys  @relation(fields: [apiKeyId], references: [id])

  @@unique([apiKeyId, name])
  @@index([apiKeyId])
}

model sent_emails {
  id        String   @id
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model sequence_enrollments {
  id                                  String         @id
  sequenceId                          String
  email                               String
  leadId                              String?
  status                              String         @default("active")
  currentStep                         Int            @default(0)
  nextSendAt                          DateTime?
  variables                           Json?
  enrolledAt                          DateTime       @default(now())
  completedAt                         DateTime?
  repliedAt                           DateTime?
  ignoreDuplicateInOtherSequences     Boolean        @default(false)
  ignoreBlockList                     Boolean        @default(false)
  ignore_duplicate_in_other_sequences Boolean        @default(false)
  mailboxId                           String?
  reply_events                        reply_events[]
  sequences                           sequences      @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, email])
  @@index([sequenceId, status, nextSendAt])
}

model sequence_steps {
  id                String              @id
  sequenceId        String
  stepOrder         Int
  delayDays         Int                 @default(0)
  delayHours        Int                 @default(0)
  subject           String
  htmlBody          String
  textBody          String?
  condition         String              @default("always")
  createdAt         DateTime            @default(now())
  type              String              @default("email")
  taskNote          String?
  sequences         sequences           @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequence_variants sequence_variants[]

