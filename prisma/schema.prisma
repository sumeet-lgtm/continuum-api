generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DATABASE_URL is the transaction-mode PgBouncer pooler (required — the
  // 15-connection session-mode pooler was getting exhausted across 6+
  // services and causing real send failures). But `prisma migrate deploy`
  // (web's start command) uses advisory locks and prepared statements that
  // transaction-mode pooling breaks ("prepared statement s0 does not
  // exist"), so migrations need a real, unpooled/session connection —
  // DIRECT_URL supplies that, used only at migrate-deploy time.
  directUrl = env("DIRECT_URL")
}

// ─── Users (WorkOS SSO) ──────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  workosId  String?  @unique @map("workos_id")
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  orgId     String?  @map("org_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orgMemberships OrgMember[]

  @@map("users")
}

// ─── Org Members (WorkOS org memberships) ────────────────────────────────────

model OrgMember {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  orgId        String   @map("org_id")
  membershipId String   @unique @map("membership_id")
  role         String   @default("member")
  email        String
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("org_members")
}

// ─── Org Settings ─────────────────────────────────────────────────────────────

model OrgSettings {
  id          String   @id @default(cuid())
  orgId       String   @unique @map("org_id")
  name        String?
  domain      String?
  mfaRequired Boolean  @default(false) @map("mfa_required")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("org_settings")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
// logAudit() previously no-op'd entirely whenever orgId was null or
// WORKOS_API_KEY was unset — meaning any customer not on the org/SSO flow
// (most customers) got zero audit trail, and even org customers had no
// audit record visible except inside WorkOS's own dashboard. This table
// is written for every audited action regardless of org/WorkOS config;
// the WorkOS mirror (when applicable) is additive, not a replacement.

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?  @map("org_id")
  apiKeyId   String?  @map("api_key_id")
  action     String
  actorId    String   @map("actor_id")
  actorEmail String   @map("actor_email")
  actorIp    String?  @map("actor_ip")
  targets    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@index([apiKeyId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── API Keys ────────────────────────────────────────────────────────────────

model ApiKey {
  id                 String    @id @default(cuid())
  keyHash            String    @unique // SHA-256(salt + raw_key)
  keyPrefix          String    // first 8 chars of raw key for display/support
  label              String?
  ownerId            String? // external user/org ID from the calling system
  userId             String? // Supabase auth user ID
  // WorkOS org this key belongs to, when the owning user signed in via an
  // org SSO connection. Previously nothing tied an API key to an org at
  // all — org admin/member roles governed the WorkOS-managed dashboard
  // shell (invites, role changes) but had no bearing on the actual
  // product resources (verifications, sends, contacts, ...) every one of
  // those keys owns. See routes/org/index.ts's api-keys endpoints.
  orgId              String?   @map("org_id")
  keyRaw             String? // full raw key stored for dashboard use
  rateLimit          Int       @default(1000) // requests per minute ceiling
  monthlyLimit       Int       @default(1000) // max verifications per month
  currentMonthUsage  Int       @default(0) // verifications used this month
  usageResetAt       DateTime  @default(dbgenerated("date_trunc('month', now() + interval '1 month')"))
  plan               String    @default("free") // free, starter, growth, scale
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  revokedAt          DateTime?

  monthlySendLimit      Int @default(500) // max /v1/send calls per month
  currentMonthSendUsage Int @default(0)   // sends used this month — separate counter from verification usage
  sendUsageResetAt DateTime @default(dbgenerated("date_trunc('month', now() + interval '1 month')"))

  // Finder gets its own guaranteed monthly allowance, separate from the
  // general verification pool — a customer who bulk-verifies their own
  // list early in the month must never find themselves locked out of
  // lead-finding for the rest of it. Resets alongside currentMonthUsage
  // (same usageResetAt cadence — no need for a third reset timestamp).
  // Once this allowance is spent, Finder overflows into the general
  // verification pool at 2 credits/lead (see usageMeter.ts) — the same
  // pool the existing extraVerificationCredits top-ups already refill, so
  // no separate "lead pack" purchase flow is needed.
  currentMonthFinderUsage Int @default(0) @map("current_month_finder_usage")

  // Pay-per-use credit packs (non-expiring top-ups on top of monthly quota)
  extraVerificationCredits Int @default(0) @map("extra_verification_credits")
  extraSendCredits         Int @default(0) @map("extra_send_credits")

  // Self-service key management
  name               String?   // human label for this key
  permission         String    @default("full_access") // full_access | sending_access
  restrictedDomainId String?   // if set, sending_access key is pinned to this domain
  lastUsedAt         DateTime?

  // Security: IP allowlist (empty = allow all IPs)
  allowedIps         String[]  @default([]) @map("allowed_ips")

  // Usage alerts: email owner at 80% of monthly quota
  usageAlertEnabled  Boolean   @default(true)  @map("usage_alert_enabled")
  usageAlertSentAt   DateTime? @map("usage_alert_sent_at")

  // Key expiry: auto-revoke at this UTC datetime (null = never expires)
  expiresAt          DateTime? @map("expires_at")

  verifications  Verification[]
  bulkJobs       BulkJob[]
  monitors       Monitor[]
  webhooks       Webhook[]
  sendMessages   SendMessage[]
  sendingDomains SendingDomain[]
  emailTemplates EmailTemplate[]
  mailingLists   MailingList[]
  contacts       Contact[]
  segments       Segment[]
  campaigns      Campaign[]
  mailboxes      Mailbox[]
  sequences      Sequence[]
  leads          Lead[]
  accounts       Account[]
  inboxTests     InboxTest[]
  automations    Automation[]
  requestLogs    ApiRequestLog[]
  teamMembers    TeamMember[]
  teamInvites    TeamInvite[]

  // Added 2026-09-04 alongside the brand_kits/connector_* tables above —
  // those models are kept snake_case, so these back-relations are too.
  brand_kits        brand_kits?
  connector_secrets connector_secrets[]
  connector_rules   connector_rules[]
  connector_events  connector_events[]
  salesforceConnection SalesforceConnection?

  @@index([orgId])
  @@map("api_keys")
}

// ─── Team (workspace multi-user RBAC) ────────────────────────────────────────

model TeamMember {
  id             String   @id @default(cuid())
  workspaceKeyId String
  email          String
  role           String   @default("member") // admin | member (owner = ApiKey creator)
  invitedBy      String?
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspaceKey   ApiKey   @relation(fields: [workspaceKeyId], references: [id])

  @@unique([workspaceKeyId, email])
  @@index([email])
  @@map("team_members")
}

model TeamInvite {
  id             String   @id @default(cuid())
  workspaceKeyId String
  inviteeEmail   String
  role           String   @default("member")
  token          String   @unique @default(cuid())
  status         String   @default("pending") // pending | accepted | revoked
  expiresAt      DateTime
  invitedBy      String
  createdAt      DateTime @default(now())

  workspaceKey   ApiKey   @relation(fields: [workspaceKeyId], references: [id])

  @@index([token])
  @@index([workspaceKeyId])
  @@index([inviteeEmail])
  @@map("team_invites")
}

// ─── API Request Logs ────────────────────────────────────────────────────────
// Best-effort log of every authenticated API call — written fire-and-forget
// in an onResponse hook. Primary use-case: developer debugging in the
// dashboard ("why did this request fail?"). Retention is 30 days.

model ApiRequestLog {
  id         String   @id @default(cuid())
  apiKeyId   String   @map("api_key_id")
  method     String   // GET | POST | PATCH | DELETE
  path       String   // cleaned path, e.g. /v1/send (no query string)
  statusCode Int      @map("status_code")
  durationMs Int      @map("duration_ms")
  sourceIp   String?  @map("source_ip")
  requestId  String?  @map("request_id")
  errorCode  String?  @map("error_code")
  createdAt  DateTime @default(now()) @map("created_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("api_request_logs")
}

// ─── Verification Results ────────────────────────────────────────────────────

model Verification {
  id              String             @id @default(cuid())
  email           String
  domain          String
  status          VerificationStatus
  subStatus       String? // granular reason: smtp_timeout, catch_all, dns_error, etc.
  syntaxValid     Boolean
  mxFound         Boolean
  mxRecords       String[]
  isDisposable    Boolean
  isRoleAccount   Boolean
  smtpChecked     Boolean
  smtpReachable   Boolean? // null when smtpChecked = false
  smtpRawResponse String?
  isCatchAll      Boolean?
  greylisted      Boolean  @default(false) // 4xx RCPT TO — address may exist, retry later
  score           Int // 0-100 internal confidence
  durationMs      Int
  checkedAt       DateTime @default(now())
  apiKeyId        String
  bulkJobId       String?
  sourceIp        String?

  apiKey  ApiKey   @relation(fields: [apiKeyId], references: [id])
  bulkJob BulkJob? @relation(fields: [bulkJobId], references: [id])
  sendMessages SendMessage[]

  @@index([email])
  @@index([apiKeyId])
  @@index([checkedAt])
  @@index([bulkJobId])
  @@map("verifications")
}

enum VerificationStatus {
  valid
  invalid
  risky
  unknown
}

// ─── Bulk CSV Jobs ────────────────────────────────────────────────────────────

model BulkJob {
  id             String        @id @default(cuid())
  apiKeyId       String
  fileName       String // original filename from upload
  storagePath    String // Supabase Storage object path in uploads bucket
  totalEmails    Int
  processedCount Int           @default(0)
  validCount     Int           @default(0)
  invalidCount   Int           @default(0)
  riskyCount     Int           @default(0)
  unknownCount   Int           @default(0)
  duplicateCount Int           @default(0) // rows skipped as duplicates of earlier rows
  errorCount     Int           @default(0) // rows where the engine threw unexpectedly
  status         BulkJobStatus @default(pending)
  errorMessage   String?
  exportPath     String? // Supabase Storage path in exports bucket (optional — results also in DB)
  createdAt      DateTime      @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  webhookSent    Boolean       @default(false)

  apiKey        ApiKey          @relation(fields: [apiKeyId], references: [id])
  verifications Verification[]
  emailRows     BulkJobEmail[]

  @@index([apiKeyId])
  @@index([status])
  @@index([createdAt])
  @@map("bulk_jobs")
}

// ─── Per-row result tracking ──────────────────────────────────────────────────

model BulkJobEmail {
  id             String    @id @default(cuid())
  bulkJobId      String
  email          String
  rowIndex       Int       // 0-based position in the original CSV (after header strip)
  isDuplicate    Boolean   @default(false)

  // Populated after verification completes (null while pending/duplicate)
  status         String?
  subStatus      String?
  score          Int?
  domain         String?
  syntaxValid    Boolean?
  isDisposable   Boolean?
  isRoleAccount  Boolean?
  mxFound        Boolean?
  smtpChecked    Boolean?
  smtpReachable  Boolean?
  isCatchAll     Boolean?
  greylisted     Boolean   @default(false)
  spfValid       Boolean?
  dkimFound      Boolean?
  dmarcValid     Boolean?
  blacklisted    Boolean?
  durationMs     Int?
  verificationId String?   // FK to Verification.id — nullable because engine may fail
  errorMessage   String?   // set only if engine threw an unexpected error
  processedAt    DateTime?

  bulkJob BulkJob @relation(fields: [bulkJobId], references: [id], onDelete: Cascade)

  @@index([bulkJobId])
  @@index([bulkJobId, status])
  @@index([bulkJobId, rowIndex])
  @@map("bulk_job_emails")
}

enum BulkJobStatus {
  pending
  processing
  completed
  failed
  cancelled
}

// ─── Monitored Emails ─────────────────────────────────────────────────────────

model Monitor {
  id                   String              @id @default(cuid())
  apiKeyId             String
  email                String
  intervalHours        Int                 @default(24)
  isActive             Boolean             @default(true)
  lastCheckedAt        DateTime?
  nextCheckAt          DateTime
  lastStatus           VerificationStatus?
  consecutiveFailures  Int                 @default(0) // incremented on engine error, reset on success
  pausedAt             DateTime?           // set when consecutiveFailures >= MAX_FAILURES
  failureReason        String?             // last error message when paused
  tags                 String[]            // caller-defined labels for filtering
  notifyOnAnyChange    Boolean             @default(true) // fire webhook on every status change
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  apiKey ApiKey         @relation(fields: [apiKeyId], references: [id])
  checks MonitorCheck[]

  @@unique([apiKeyId, email])
  @@index([nextCheckAt])
  @@index([isActive, nextCheckAt])
  @@map("monitors")
}

// ─── Monitor Check History ────────────────────────────────────────────────────

model MonitorCheck {
  id             String              @id @default(cuid())
  monitorId      String
  verificationId String
  statusChanged  Boolean
  previousStatus VerificationStatus?
  newStatus      VerificationStatus
  source         String              @default("scheduled") // "scheduled" | "manual_recheck"
  checkedAt      DateTime            @default(now())
  durationMs     Int?                // total wall time for this check in ms
  webhookSent    Boolean             @default(false)

  monitor Monitor @relation(fields: [monitorId], references: [id])

  @@index([monitorId])
  @@index([monitorId, checkedAt])
  @@index([checkedAt])
  @@map("monitor_checks")
}

// ─── Webhook Endpoints ────────────────────────────────────────────────────────

model Webhook {
  id              String         @id @default(cuid())
  apiKeyId        String
  url             String
  secret          String         // random 32-byte hex; used for HMAC-SHA256 signature
  events          WebhookEvent[]
  label           String?        // human-readable name for the endpoint
  description     String?        // optional description
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  lastPingAt      DateTime?
  lastPingOk      Boolean?
  // Aggregate delivery stats — updated on each attempt
  totalDeliveries      Int       @default(0)
  successCount         Int       @default(0)
  failureCount         Int       @default(0)
  // Consecutive permanent failures since last success (resets to 0 on any success)
  consecutiveFailures  Int       @default(0)  @map("consecutive_failures")
  // When we last sent a failure-threshold alert — debounces repeated emails
  failureAlertSentAt   DateTime? @map("failure_alert_sent_at")

  apiKey     ApiKey            @relation(fields: [apiKeyId], references: [id])
  deliveries WebhookDelivery[]

  @@index([apiKeyId])
  @@map("webhooks")
}

enum WebhookEvent {
  // Phase 5 canonical names (stored as underscore in DB; dot-style is API-only)
  verification_complete    // emitted as "verification.completed" in payloads
  bulk_job_complete        // emitted as "bulk_job.completed" in payloads
  monitor_status_change    // emitted as "email.status_changed" in payloads
  // Phase 6 (Send)
  email_sent                // emitted as "email.sent"
  email_delivered           // emitted as "email.delivered"
  email_bounced             // emitted as "email.bounced"
  email_complained          // emitted as "email.complained"
  email_send_failed         // emitted as "email.send_failed"
}

// ─── Webhook Delivery Log ─────────────────────────────────────────────────────

model WebhookDelivery {
  id                String       @id @default(cuid())
  webhookId         String
  event             WebhookEvent
  eventId           String?      // idempotency key: "<event>:<sourceId>"
  payload           Json
  attempts          Int          @default(0)
  maxAttempts       Int          @default(5)
  nextRetryAt       DateTime?
  lastAttemptAt     DateTime?
  statusCode        Int?
  responseBody      String?
  errorMessage      String?      // last failure reason in human-readable form
  delivered         Boolean      @default(false)
  failedPermanently Boolean      @default(false) // true when maxAttempts exhausted
  createdAt         DateTime     @default(now())

  webhook  Webhook          @relation(fields: [webhookId], references: [id])
  attempts_ WebhookAttempt[] @relation("DeliveryAttempts")

  @@index([delivered, nextRetryAt])
  @@index([webhookId])
  @@index([eventId])
  @@map("webhook_deliveries")
}

// ─── Per-attempt HTTP log ─────────────────────────────────────────────────────

model WebhookAttempt {
  id            String    @id @default(cuid())
  deliveryId    String
  attemptNumber Int
  requestedAt   DateTime
  respondedAt   DateTime?
  durationMs    Int?
  statusCode    Int?
  responseBody  String?
  // Structured error classification
  errorType     String?   // "timeout" | "connection_refused" | "http_error" | "network_error"
  errorMessage  String?
  success       Boolean   @default(false)

  delivery WebhookDelivery @relation("DeliveryAttempts", fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([deliveryId, attemptNumber])
  @@map("webhook_attempts")
}

// ─── SMTP Result Cache ────────────────────────────────────────────────────────
// Stores SMTP verification results to avoid redundant API calls
// Results are reused across all users — shared cache builds moat over time

model SmtpCache {
  id            String   @id @default(cuid())
  email         String   @unique
  reachable     Boolean?
  isCatchAll    Boolean?
  resultCode    Int      // MillionVerifier result code
  result        String   // ok, error, unknown, disposable
  subResult     String?
  checkedAt     DateTime @default(now())
  expiresAt     DateTime // TTL: 30d valid, 7d invalid, 1d unknown

  @@index([email])
  @@index([expiresAt])
  @@map("smtp_cache")
}

// Whether a domain's mail server accepts RCPT TO for any address ("catch-all")
// is a property of that domain's mail server config, not of any one mailbox
// on it — but SmtpCache above can only ever cache a hit for the exact email
// checked before. A bulk list is routinely dozens or hundreds of different
// addresses at the same handful of company domains (a Finder-sourced lead
// list, or a company's own contact export), so re-probing catch-all status
// live for every single email in it is pure waste. This lets every email
// after the first at a given domain skip that live SMTP round trip entirely
// — shared across all customers, same reasoning as SmtpCache being shared.
model DomainCatchAllCache {
  id         String   @id @default(cuid())
  domain     String   @unique
  isCatchAll Boolean
  checkedAt  DateTime @default(now())
  expiresAt  DateTime // 7d TTL — mail-server config can change, but rarely

  @@index([expiresAt])
  @@map("domain_catchall_cache")
}

// ─── Phase 6: Send ────────────────────────────────────────────────────────────
// Transactional sending on top of verification. verifyEmail() already exists
// and stores per-address history — SendMessage reads from it (verify-before-send)
// so a send can be checked against the same dataset instead of a second product.

model SendMessage {
  id             String     @id @default(cuid())
  apiKeyId       String
  to             String
  from           String
  replyTo        String?
  cc             String[]   @default([])
  bcc            String[]   @default([])
  subject        String
  sesMessageId   String?    @unique
  status         SendStatus @default(queued)
  errorMessage   String?
  verificationId String?
  domainId       String?
  templateId      String?
  sequenceStepId  String?   @map("sequence_step_id") // set for sequence sends — used in funnel analytics
  tags            Json?
  trackingToken   String?    @unique
  idempotencyKey  String?    @unique
  scheduledAt     DateTime?
  createdAt       DateTime   @default(now())
  sentAt          DateTime?

  apiKey         ApiKey        @relation(fields: [apiKeyId], references: [id])
  verification   Verification? @relation(fields: [verificationId], references: [id])
  events         SendEvent[]
  trackingEvents TrackingEvent[]

  @@index([apiKeyId])
  @@index([apiKeyId, createdAt])
  @@index([sesMessageId])
  @@index([sequenceStepId])
  @@map("send_messages")
}

enum SendStatus {
  queued
  scheduled
  sent
  delivered
  opened
  clicked
  bounced
  complained
  failed
  cancelled
}

// ─── Per-message delivery event log (from SES → SNS) ─────────────────────────

model SendEvent {
  id            String        @id @default(cuid())
  sendMessageId String
  type          SendEventType
  rawPayload    Json          // the raw SES/SNS notification, kept for debugging
  occurredAt    DateTime      @default(now())

  sendMessage SendMessage @relation(fields: [sendMessageId], references: [id], onDelete: Cascade)

  @@index([sendMessageId])
  @@map("send_events")
}

enum SendEventType {
  sent
  delivered
  bounced
  complained
  failed
}

// ─── Suppression list ─────────────────────────────────────────────────────────
// GLOBAL, not per-key: v1 shares one SES sending domain/reputation across every
// customer, so a hard bounce or complaint under any one apiKeyId threatens
// everyone's deliverability. apiKeyId is kept only to show each customer which
// of their own sends triggered a global suppression, never to scope the check.

model Suppression {
  id        String            @id @default(cuid())
  email     String            @unique
  reason    SuppressionReason
  apiKeyId  String?           // which customer's send (if any) triggered this
  createdAt DateTime          @default(now())

  @@index([email])
  @@map("suppressions")
}

enum SuppressionReason {
  hard_bounce
  complaint
  manual
  soft_bounce
  unsubscribed
}

// ─── Soft Bounce Tracker (3-strike suppression) ──────────────────────────────

model SoftBounceTrack {
  id            String   @id @default(cuid())
  email         String   @unique
  apiKeyId      String?  @map("api_key_id")
  bounceCount   Int      @default(1) @map("bounce_count")
  lastBounceAt  DateTime @default(now()) @map("last_bounce_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("soft_bounce_tracks")
}

// ─── Custom Sending Domains ───────────────────────────────────────────────────

model SendingDomain {
  id                String    @id @default(cuid())
  apiKeyId          String
  name              String
  status            String    @default("pending") // pending|verified|failed
  region            String    @default("us-east-1")
  dkimSelector      String
  dkimPublicKey     String
  dkimPrivateKeyEnc String
  spfStatus         String    @default("pending")
  dkimStatus        String    @default("pending")
  returnPathStatus  String    @default("pending")
  trackOpens        Boolean   @default(true)
  trackClicks       Boolean   @default(true)
  trackingDomain    String?   // custom tracking domain e.g. "track.yourdomain.com" — overrides api.continuumapi.com for pixels/redirects
  createdAt         DateTime  @default(now())
  verifiedAt        DateTime?

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@unique([apiKeyId, name])
  @@index([apiKeyId])
  @@map("sending_domains")
}

// ─── Email Templates ──────────────────────────────────────────────────────────

model EmailTemplate {
  id        String   @id @default(cuid())
  apiKeyId  String
  name      String
  subject   String
  htmlBody  String
  textBody  String?
  preheader String?
  variables Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKey   ApiKey                 @relation(fields: [apiKeyId], references: [id])
  versions EmailTemplateVersion[]

  @@index([apiKeyId])
  @@map("email_templates")
}

model EmailTemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  version    Int
  name       String
  subject    String
  htmlBody   String
  textBody   String?
  variables  Json?
  savedAt    DateTime @default(now())
  savedBy    String?  // email of user who made the change

  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, version])
  @@map("email_template_versions")
}

// ─── Open / Click Tracking Events ────────────────────────────────────────────

model TrackingEvent {
  id            String   @id @default(cuid())
  sendMessageId String?
  campaignId    String?
  sequenceId    String?
  email         String
  type          String   // open|click
  linkUrl       String?
  userAgent     String?
  ip            String?
  occurredAt    DateTime @default(now())

  sendMessage SendMessage? @relation(fields: [sendMessageId], references: [id])

  @@index([sendMessageId])
  @@index([campaignId])
  @@index([sequenceId])
  @@map("tracking_events")
}

// ─── Mailing Lists (newsletter / permission-based) ────────────────────────────

model MailingList {
  id           String   @id @default(cuid())
  apiKeyId     String
  name         String
  description  String?
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKey      ApiKey                  @relation(fields: [apiKeyId], references: [id])
  memberships ContactListMembership[]
  campaigns   Campaign[]              @relation("CampaignLists")

  @@index([apiKeyId])
  @@map("mailing_lists")
}

// ─── Contacts (opt-in subscribers) ───────────────────────────────────────────

model Contact {
  id           String   @id @default(cuid())
  apiKeyId     String
  email        String
  firstName    String?
  lastName     String?
  customFields Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKey      ApiKey                  @relation(fields: [apiKeyId], references: [id])
  memberships ContactListMembership[]

  @@unique([apiKeyId, email])
  @@index([apiKeyId])
  @@map("contacts")
}

model ContactListMembership {
  id             String    @id @default(cuid())
  contactId      String
  listId         String
  status         String    @default("subscribed") // subscribed|unsubscribed|bounced|complained
  gdprConsent    Boolean   @default(false)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list    MailingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
  @@index([listId, status])
  @@map("contact_list_memberships")
}

// ─── Segments ─────────────────────────────────────────────────────────────────

model Segment {
  id          String   @id @default(cuid())
  apiKeyId    String
  listId      String?
  name        String
  filterRules Json
  createdAt   DateTime @default(now())

  apiKey    ApiKey       @relation(fields: [apiKeyId], references: [id])
  campaigns Campaign[]  @relation("CampaignSegments")

  @@index([apiKeyId])
  @@map("segments")
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

model Campaign {
  id             String    @id @default(cuid())
  apiKeyId       String
  name           String    @default("")
  fromName       String
  fromEmail      String
  domainId       String?
  replyTo        String?
  subject        String
  htmlBody       String
  textBody       String?
  preheader      String?
  status         String    @default("draft") // draft|scheduled|sending|sent|failed|cancelled|paused_bounce|paused_quota
  errorMessage   String?                       // set when status=failed — why the send worker gave up
  listIds        String[]  @default([])
  segmentIds     String[]  @default([])
  excludeListIds String[]  @default([])
  trackOpens     Boolean   @default(true)
  trackClicks    Boolean   @default(true)
  scheduledAt    DateTime?
  sentAt         DateTime?
  totalRecipients Int      @default(0)
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  openCount      Int       @default(0)
  clickCount     Int       @default(0)
  bounceCount    Int       @default(0)
  complaintCount Int       @default(0)
  subjectB       String?   @map("subject_b")   // A/B test: variant B subject line
  openCountB     Int       @default(0) @map("open_count_b")  // A/B test: opens from B variant
  clickCountB    Int       @default(0) @map("click_count_b") // A/B test: clicks from B variant
  excludedEmails String[]  @default([]) @map("excluded_emails")  // retarget: emails to skip (openers of source campaign)
  retargetOfId   String?   @map("retarget_of_id")                // retarget: source campaign ID
  sendRatePerHour Int?     @map("send_rate_per_hour")             // drip: max emails/hr; null = unlimited
  sendDays       String[]  @default(["monday","tuesday","wednesday","thursday","friday"])
  sendStartHour  Int       @default(8)
  sendEndHour    Int       @default(17)
  timezone       String    @default("UTC")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  apiKey     ApiKey              @relation(fields: [apiKeyId], references: [id])
  recipients CampaignRecipient[]
  lists      MailingList[]       @relation("CampaignLists")
  segments   Segment[]           @relation("CampaignSegments")

  @@index([apiKeyId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id           String    @id @default(cuid())
  campaignId   String
  contactId    String?
  email        String
  status       String    @default("pending") // pending|sent|delivered|bounced|complained|failed
  variant      String    @default("a")       // a|b for A/B test campaigns
  sesMessageId String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([sesMessageId])
  @@map("campaign_recipients")
}

// ─── Mailboxes (cold outreach / multi-sender) ─────────────────────────────────

model Mailbox {
  id               String    @id @default(cuid())
  apiKeyId         String
  type             String    // smtp|gmail|outlook
  label            String?
  host             String?
  port             Int?
  username         String
  passwordEnc      String?
  oauthTokenEnc    String?
  dailyLimit       Int       @default(200)
  sendDelayMinMs   Int       @default(30000)
  sendDelayMaxMs   Int       @default(120000)
  sentToday        Int       @default(0)
  sentTodayResetAt DateTime  @default(now())
  status           String    @default("active") // active|paused|error
  lastErrorMsg     String?
  lastCheckedAt    DateTime?
  createdAt        DateTime  @default(now())
  // House-owned seed mailbox, dedicated purely to warming up customer
  // mailboxes against — see warmupWorker.ts. The shared warmup pool is
  // cross-customer with no apiKeyId scoping, and needs at least one other
  // active mailbox to pair with; with few real customers enrolled at once
  // that requirement was never met and ticks silently no-op'd forever.
  // House-pool mailboxes are guaranteed partners so a single customer's
  // mailbox can always warm up, independent of how many other customers
  // happen to be enrolled at the same time.
  isHousePool      Boolean   @default(false)

  apiKey       ApiKey        @relation(fields: [apiKeyId], references: [id])
  warmupConfig WarmupConfig?
  replyEvents  ReplyEvent[]

  @@index([apiKeyId, status])
  @@index([isHousePool, status])
  @@map("mailboxes")
}

model WarmupConfig {
  id            String   @id @default(cuid())
  mailboxId     String   @unique
  enabled       Boolean  @default(true)
  targetPerDay  Int      @default(40)
  currentPerDay Int      @default(5)
  rampUpDays    Int      @default(30)
  dailyRampUp   Int      @default(2)   // emails to add per day
  replyRatePct  Int      @default(20)  // % of warmup emails that get auto-replied
  lastRampDate  String?  // ISO date YYYY-MM-DD; prevents double-ramp per day
  poolTier      String   @default("standard") // basic|standard|premium
  startedAt     DateTime @default(now())

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@map("warmup_configs")
}

// ─── Sequences (cold outreach drip campaigns) ─────────────────────────────────

model Sequence {
  id           String   @id @default(cuid())
  apiKeyId     String
  mailboxId    String?
  name         String
  fromName     String
  fromEmail    String
  status       String   @default("active") // active|paused|archived
  trackOpens   Boolean  @default(true)
  trackClicks  Boolean  @default(true)
  stopOnReply       Boolean  @default(true)
  stopOnOpen        Boolean  @default(false)
  stopOnClick       Boolean  @default(false)
  sendDays          String[] @default(["monday","tuesday","wednesday","thursday","friday"])
  sendStartHour     Int      @default(8)
  sendEndHour       Int      @default(17)
  timezone          String   @default("UTC")
  parentSequenceId  String?  // subsequence: links to parent sequence
  triggerEvent      String?  // REPLIED|OPENED|CLICKED|NOT_REPLIED_IN_DAYS|NOT_OPENED_IN_DAYS
  triggerDelayDays  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  apiKey      ApiKey               @relation(fields: [apiKeyId], references: [id])
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([apiKeyId])
  @@index([parentSequenceId])
  @@map("sequences")
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  stepOrder  Int
  delayDays  Int      @default(0)
  delayHours Int      @default(0)
  type       String   @default("email") // email | call | linkedin | task
  subject    String   @default("")
  htmlBody   String   @default("")
  textBody   String?
  taskNote   String?  // instructions for manual steps (call/linkedin/task)
  condition  String   @default("always") // always|if_not_opened|if_opened|if_not_clicked|if_not_replied
  createdAt  DateTime @default(now())

  sequence Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  variants SequenceVariant[]

  @@unique([sequenceId, stepOrder])
  @@map("sequence_steps")
}

model SequenceVariant {
  id           String @id @default(cuid())
  stepId       String
  variantLabel String // "A", "B", "C"
  subject      String
  htmlBody     String
  textBody     String?
  weight       Int    @default(50)

  step SequenceStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("sequence_variants")
}

model SequenceEnrollment {
  id                               String    @id @default(cuid())
  sequenceId                       String
  email                            String
  leadId                           String?
  mailboxId                        String?   // mailbox used for step 0 — reused for all follow-ups (thread coherence)
  status                           String    @default("active") // active|paused|completed|unsubscribed|bounced|replied
  currentStep                      Int       @default(0)
  nextSendAt                       DateTime?
  variables                        Json?
  enrolledAt                       DateTime  @default(now())
  completedAt                      DateTime?
  repliedAt                        DateTime?
  ignoreBlockList                  Boolean   @default(false)
  ignoreDuplicateInOtherSequences  Boolean   @default(false)

  sequence    Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  replyEvents ReplyEvent[]

  @@unique([sequenceId, email])
  @@index([sequenceId, status, nextSendAt])
  @@map("sequence_enrollments")
}

// ─── Leads (cold outreach targets, distinct from newsletter contacts) ─────────

model Lead {
  id             String    @id @default(cuid())
  apiKeyId       String
  email          String
  firstName      String?
  lastName       String?
  company        String?
  title          String?
  tags           String[]  @default([])
  customVars     Json?
  status         String    @default("active") // active|interested|not_interested|replied|unsubscribed|bounced|do_not_contact
  repliedAt      DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id])
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id])

  @@unique([apiKeyId, email])
  @@index([apiKeyId, status])
  @@index([accountId])
  @@map("leads")
}

// ─── Accounts (company entities that group multiple leads) ────────────────────

model Account {
  id          String   @id @default(cuid())
  apiKeyId    String
  name        String
  domain      String?
  industry    String?
  employees   Int?
  revenue     String?
  website     String?
  linkedin    String?
  city        String?
  country     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])
  leads  Lead[]

  @@unique([apiKeyId, domain])
  @@index([apiKeyId])
  @@map("accounts")
}

// ─── Reply Events (IMAP-detected replies) ────────────────────────────────────

model ReplyEvent {
  id                   String    @id @default(cuid())
  mailboxId            String
  fromEmail            String
  inReplyToMessageId   String?
  // The prospect's own Message-ID header — distinct from inReplyToMessageId
  // (what THEY were replying to). Needed to thread our reply-to-the-reply
  // correctly (In-Reply-To/References) instead of starting a new thread.
  messageId            String?
  enrollmentId         String?
  campaignRecipientId  String?
  subject              String?
  bodySnippet          String?
  isRead               Boolean   @default(false)
  status               String    @default("new") // new|interested|not_interested|archived
  repliedAt            DateTime?
  receivedAt           DateTime  @default(now())

  mailbox    Mailbox             @relation(fields: [mailboxId], references: [id])
  enrollment SequenceEnrollment? @relation(fields: [enrollmentId], references: [id])

  @@index([mailboxId])
  @@index([enrollmentId])
  @@map("reply_events")
}

// ─── Inbox Placement Tests ────────────────────────────────────────────────────

model InboxTest {
  id        String   @id @default(cuid())
  apiKeyId  String
  subject   String
  fromEmail String
  domainId  String?
  status    String   @default("pending") // pending|checking|complete|failed
  results   Json?
  score     Int?
  createdAt DateTime @default(now())
  checkedAt DateTime?

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId])
  @@map("inbox_tests")
}

// ─── Sequence Templates (curated library) ────────────────────────────────────

model SequenceTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("cold_outreach") // cold_outreach|follow_up|re_engagement
  steps       Json
  createdAt   DateTime @default(now())

  @@map("sequence_templates")
}

// ─── Email Automations (event-triggered drip — Resend parity) ────────────────

model Automation {
  id           String   @id @default(cuid())
  apiKeyId     String   @map("api_key_id")
  name         String
  triggerEvent String   @map("trigger_event")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id])
  steps       AutomationStep[]
  enrollments AutomationEnrollment[]

  @@index([apiKeyId])
  @@index([apiKeyId, triggerEvent])
  @@map("automations")
}

model AutomationStep {
  id           String  @id @default(cuid())
  automationId String  @map("automation_id")
  stepOrder    Int     @map("step_order")
  delayHours   Int     @default(0) @map("delay_hours")
  subject      String
  htmlBody     String  @map("html_body")
  textBody     String? @map("text_body")
  fromName     String? @map("from_name")
  fromEmail    String? @map("from_email")
  domainId     String? @map("domain_id")

  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, stepOrder])
  @@map("automation_steps")
}

model AutomationEnrollment {
  id           String    @id @default(cuid())
  automationId String    @map("automation_id")
  email        String
  data         Json?
  status       String    @default("active")
  currentStep  Int       @default(0) @map("current_step")
  nextSendAt   DateTime? @map("next_send_at")
  enrolledAt   DateTime  @default(now()) @map("enrolled_at")
  completedAt  DateTime? @map("completed_at")

  automation    Automation @relation(fields: [automationId], references: [id])

  @@unique([automationId, email])
  @@index([status, nextSendAt])
  @@map("automation_enrollments")
}

// ─── Brand kit + payment connectors (added 2026-09-04, migration
// 20260904_brand_kit_connectors.sql) — written against, and left in,
// snake_case model/field naming since that's how routes/brand/index.ts and
// routes/connectors/payment.ts already call them; unlike the models above,
// there is no camelCase convention to restore here. ──────────────────────

model brand_kits {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  api_key_id    String   @unique
  logo_url      String?
  primary_color String   @default("#000000")
  font_family   String   @default("Arial, sans-serif")
  company_name  String?
  from_name     String?
  footer_text   String?
  website_url   String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  api_keys      ApiKey   @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

model connector_secrets {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  api_key_id   String
  connector    String
  secret       String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  api_keys     ApiKey   @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@unique([api_key_id, connector])
  @@map("connector_secrets")
}

model connector_rules {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  api_key_id  String
  connector   String
  event_type  String
  action      String   @default("send_template")
  template_id String?
  sequence_id String?
  enabled     Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  api_keys    ApiKey   @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@unique([api_key_id, connector, event_type])
  @@index([api_key_id])
  @@map("connector_rules")
}

model connector_events {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  api_key_id   String
  connector    String
  event_type   String
  normalized   Json
  status       String   @default("received")
  error_msg    String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  api_keys     ApiKey   @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@index([api_key_id, created_at(sort: Desc)])
  @@index([api_key_id, connector])
  @@map("connector_events")
}

// ─── Salesforce two-way sync (added 2026-09-04) ───────────────────────────
// One Continuum-owned Connected App (SALESFORCE_CLIENT_ID/SECRET) is
// authorized per-customer against THEIR org via standard OAuth2 — same
// multi-tenant pattern as the Gmail/Outlook mailbox connect, not a
// per-customer app registration.

model SalesforceConnection {
  id              String    @id @default(cuid())
  apiKeyId        String    @unique
  instanceUrl     String    // e.g. https://my-org.my.salesforce.com — every REST call must target this, not a fixed host
  refreshTokenEnc String
  orgId           String?
  connectedEmail  String?   // the Salesforce user who authorized the connection
  syncEnabled     Boolean   @default(true)
  lastPushedAt    DateTime?
  lastPulledAt    DateTime?
  lastErrorMsg    String?
  createdAt       DateTime  @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@map("salesforce_connections")
}

// One row per Continuum lead that's been pushed to Salesforce — tracks the
// SFDC record id (so re-syncs update in place instead of duplicating) and
// the last known SFDC-side status, so the pull direction can tell "the rep
// changed this in Salesforce" apart from "nothing changed since we looked".
model SalesforceLeadSync {
  id             String    @id @default(cuid())
  apiKeyId       String
  leadEmail      String
  salesforceId   String
  sfObjectType   String    @default("Lead") // Lead | Contact — a converted Lead becomes a Contact on the SFDC side
  lastPushedAt   DateTime  @default(now())
  lastSfStatus   String?
  lastSfSyncedAt DateTime?

  @@unique([apiKeyId, leadEmail])
  @@index([apiKeyId, salesforceId])
  @@map("salesforce_lead_syncs")
}
