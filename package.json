{
  "name": "continuum",
  "version": "0.1.0",
  "description": "Email verification, monitoring, and webhook API",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:raw": "node run-migration.mjs",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/generate-api-key.ts",
    "worker": "tsx src/worker.ts",
    "worker:new": "tsx src/worker-new.ts",
    "smtp:relay": "tsx src/smtp-relay.ts",
    "worker:bulk": "tsx src/workers/bulkWorker.ts",
    "worker:monitor": "tsx src/workers/monitorWorker.ts",
    "worker:webhook": "tsx src/workers/webhookWorker.ts",
    "worker:send": "tsx src/workers/sendWorker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.13.0",
    "@sentry/node": "^10.72.0",
    "@supabase/supabase-js": "^2.43.1",
    "@types/imap": "^0.8.43",
    "@types/imap-simple": "^4.2.10",
    "@types/mailparser": "^3.4.6",
    "@types/mjml": "^5.0.0",
    "@types/smtp-server": "^3.5.13",
    "@workos-inc/node": "^10.11.0",
    "bullmq": "^5.8.1",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "imap": "^0.8.19",
    "imap-simple": "^5.1.0",
    "ioredis": "^5.10.1",
    "jose": "^4.15.9",
    "libphonenumber-js": "^1.12.42",
    "mailparser": "^3.9.16",
    "mjml": "^5.4.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "smtp-server": "^3.19.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "prisma": "^5.13.0",
    "tsx": "^4.11.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "fast-uri@2.x": "^2.4.5",
    "fast-uri@3.x": "^3.1.6",
    "ws": "^8.21.0",
    "semver@5.x": "^5.7.2"
  }
}
