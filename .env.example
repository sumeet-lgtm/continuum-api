# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated allowed CORS origins in production (empty = no CORS). In development, all origins are allowed.
ALLOWED_ORIGINS=

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Format: postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
# Upstash Redis REST URL (used by @upstash/redis)
REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ─── Supabase Storage bucket names ───────────────────────────────────────────
STORAGE_BUCKET_UPLOADS=continuum-uploads
STORAGE_BUCKET_EXPORTS=continuum-exports

# ─── SMTP verification ───────────────────────────────────────────────────────
# Set to false on cloud hosts that block outbound port 25 (GCP, AWS, etc.)
SMTP_CHECK_ENABLED=true
SMTP_CHECK_TIMEOUT_MS=5000
# Domain sent in EHLO/HELO — must be a real domain with valid forward DNS
SMTP_HELO_DOMAIN=verify.yourdomain.com

# ─── SMTP verification provider (via Cloudflare Worker proxy) ────────────────
# Cloud hosts block outbound port 25, so SMTP-level checks are outsourced to a
# provider HTTP API called through a Cloudflare Worker proxy. Provider keys are
# tried in order: DeBounce > Bouncer > MillionVerifier. If proxy URL/key or all
# provider keys are missing, SMTP checks are skipped gracefully (status=unknown).
MV_PROXY_URL=https://your-proxy.workers.dev
MV_PROXY_KEY=your-proxy-shared-secret
DEBOUNCE_API_KEY=
BOUNCER_API_KEY=
MILLIONVERIFIER_API_KEY=

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Per API key, per minute ceiling. Individual keys can have lower limits set in DB.
DEFAULT_RATE_LIMIT_RPM=1000

# ─── Webhook delivery ────────────────────────────────────────────────────────
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=10000

# ─── Billing (Dodo Payments) ─────────────────────────────────────────────────
# Without these, POST /v1/billing/checkout returns 503 and the webhook (in
# production) refuses to process — billing is safely "off", not half-on.
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=whsec_...
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_SCALE=
# Where checkout returns the customer after payment
DASHBOARD_URL=https://app.continuumapi.com

# ─── Transactional email (Resend) ────────────────────────────────────────────
# Lifecycle emails (welcome, quota warnings, upgrade confirmations) are OFF
# until this is set. Domain for SUPPORT_EMAIL must be verified in Resend.
RESEND_API_KEY=
SUPPORT_EMAIL=sumeet@continuumapi.com

# ─── Send (Amazon SES) — Phase 6 ─────────────────────────────────────────────
# POST /v1/send returns 503 until these are set — everything else in Phase 6
# (schema, quota, suppression, webhooks) works and is testable without them.
# SES_FROM_DOMAIN needs to be a domain verified in SES (DKIM records added to
# its DNS zone) before real sends will land anywhere but the mailbox simulator.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Name of an SES Configuration Set with an SNS destination pointed at
# POST /v1/send/events (bounce/complaint/delivery notifications).
SES_CONFIGURATION_SET=
SES_FROM_DOMAIN=relay.continuumapi.com
# ARN of the SNS topic SES publishes events to — informational only today
# (the events route verifies the SNS message signature itself, not the ARN),
# but keeping it here documents which topic this deployment expects.
SES_SNS_TOPIC_ARN=

# ─── Alerts ──────────────────────────────────────────────────────────────────
# Optional Slack-compatible webhook — receives low-credit warnings from the
# monitor worker (POST {"text": "..."}). Leave empty to alert via logs only.
ALERT_WEBHOOK_URL=
# Warn when the SMTP provider balance drops below this many credits
CREDIT_ALERT_THRESHOLD=5000

# ─── Internal ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# 32+ random characters used as additional salt before SHA-256 key hashing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_SALT=change-this-to-a-long-random-string-before-deploying
